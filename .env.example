# Copy to .env and adjust for your machine.

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/coderarena?schema=public"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app — https://github.com/settings/developers
# Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Repository chat: OpenAI for embeddings and answers, Pinecone for the vectors.
# The Pinecone index must use 512 dimensions (text-embedding-3-small, see src/lib/ai/openai.ts).
OPENAI_API_KEY=""
PINECONE_API_KEY=""
PINECONE_INDEX="coderarena"

# Inngest runs repository indexing in the background. Locally, start its dev server next to
# the app with `npx inngest-cli@latest dev` and keep INNGEST_DEV=1. In production, remove it and
# set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY instead.
INNGEST_DEV=1

# Playground sandboxes (Docker + gVisor) — see sandbox/README.md
# Docker engine that runs sandboxes; empty uses the docker CLI's default engine (a Linux host
# with gVisor installed). The dev sandbox host from `npm run sandbox:host` listens here:
SANDBOX_DOCKER_HOST="tcp://127.0.0.1:2375"
# Where that engine publishes preview ports. The dev sandbox host forwards 42000-42019 to
# this machine's loopback; on a Linux host, use 127.0.0.1 and leave the range empty.
SANDBOX_PUBLISH_ADDRESS="0.0.0.0"
SANDBOX_PORT_RANGE="42000-42019"
# Container runtime. "runc" turns off gVisor's isolation: only for debugging on your own machine.
# SANDBOX_RUNTIME="runsc"
# DNS servers for sandboxes (they can't reach private networks, so these must be public).
# SANDBOX_DNS="1.1.1.1,8.8.8.8"
# Port the preview server listens on in development (`next dev` blocks the Next.js playground's
# assets on its own port). "off" serves previews from the app's origin, as production does.
# SANDBOX_PREVIEW_PORT="3001"
